# --- PROJECT-WIDE ORCHESTRATION ---

# General
APP_NAME=MWCAST
RUST_LOG=info

# Database (PostgreSQL)
POSTGRES_USER=mwcast
POSTGRES_PASSWORD=mwcast
POSTGRES_DB=mwcast
POSTGRES_PORT=5432

# Message Queue (Kafka)
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092

# Backend API
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
API_BASE_URL=https://mwcast.mediusware.xyz/api
FRONTEND_URL=https://mwcast.mediusware.xyz

# Auth
JWT_SECRET=changeme_at_least_32_chars_random_secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Media Server (MediaMTX)
MEDIA_RTMP_PORT=1935
MEDIA_HLS_PORT=8888
MEDIA_WEBRTC_PORT=8889
MEDIA_SERVER_URL=rtmp://localhost:1935

# Public IP of your Ubuntu server (required for WebRTC ICE NAT traversal)
# Run: curl -4 ifconfig.me
SERVER_PUBLIC_IP=


